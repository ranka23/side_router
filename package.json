{
  "name": "side-router",
  "version": "3.0.0",
  "description": "SideRouter — AI chat browser extension powered by OpenRouter",
  "scripts": {
    "test": "jest --verbose",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --verbose",
    "test:e2e": "jest tests/e2e --verbose",
    "build": "node scripts/build.js",
    "build:chrome": "node scripts/build.js --chrome",
    "build:firefox": "node scripts/build.js --firefox",
    "icons": "node scripts/generate-icons.js"
  },
  "type": "commonjs",
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "html-minifier-terser": "^7.2.0",
    "jest": "^29.7.0",
    "sharp": "^0.35.1",
    "terser": "^5.48.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverage": false
  }
}
