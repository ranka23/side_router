{
  "manifest_version": 3,
  "name": "SideRouter",
  "description": "AI chat powered by OpenRouter — sidebar, floating window, and tab modes",
  "version": "3.0.0",
  "action": {
    "default_title": "SideRouter",
    "default_icon": {
      "16": "media/icon16.png",
      "32": "media/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "main.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "media/icon16.png",
    "32": "media/icon32.png",
    "48": "media/icon48.png",
    "128": "media/icon128.png"
  },
  "_firefox_note": "For Firefox: add browser_specific_settings.gecko, replace sidePanel with sidebar_action, use background.scripts instead of service_worker",
  "browser_specific_settings": {
    "gecko": {
      "id": "siderouter@example.com",
      "strict_min_version": "109.0"
    }
  }
}
