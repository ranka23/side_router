{
  "manifest_version": 3,
  "name": "OpenRouter AI Chat",
  "description": "Chat with free AI models from OpenRouter in Chrome Sidebar",
  "version": "2.0.0",
  "icons": {
    "16": "icon16.svg",
    "32": "icon32.svg",
    "48": "icon48.svg",
    "128": "icon128.svg"
  },
  "action": {
    "default_title": "OpenRouter AI Chat",
    "default_icon": {
      "16": "icon16.svg",
      "32": "icon32.svg"
    }
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html",
    "default_title": "OpenRouter AI Chat"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}