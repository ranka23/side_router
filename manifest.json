{
  "manifest_version": 3,
  "name": "OpenRouter AI Chat",
  "description": "Chat with free AI models from OpenRouter directly in your Chrome sidebar",
  "version": "2.0.0",
  "action": {
    "default_title": "OpenRouter AI Chat",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://openrouter.ai/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
