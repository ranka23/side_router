{
  "manifest_version": 3,
  "name": "SideRouter",
  "description": "AI chat powered by OpenRouter — sidebar, floating window, and tab modes",
  "version": "3.0.0",
  "action": {
    "default_title": "SideRouter",
    "default_icon": {
      "16": "media/icon16.png",
      "32": "media/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "sidebar_action": {
    "default_title": "SideRouter",
    "default_panel": "main.html",
    "default_icon": {
      "16": "media/icon16.png",
      "32": "media/icon32.png"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "media/icon16.png",
    "32": "media/icon32.png",
    "48": "media/icon48.png",
    "128": "media/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "siderouter@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": []
      }
    }
  }
}
